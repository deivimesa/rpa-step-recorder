# ---------------------------------------------------------------------------
# RPA Step Recorder - .gitignore
# ---------------------------------------------------------------------------

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
.venv/
venv/
env/
ENV/
.env

# Caches de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# --- PyInstaller / empaquetado --------------------------------------------
# Salidas del build: no se versionan. Los ejecutables de Windows listos para
# usar se versionan aparte en desktop/releases/windows/ y hybrid/releases/windows/
# (los copia build_exe.ps1).

desktop/build/
desktop/dist/
hybrid/build/
hybrid/dist/
*.manifest

# OJO: el .spec SÍ se versiona (es la receta reproducible del build).
# No lo ignoramos. Si generas .spec temporales, nómbralos *.tmp.spec.
*.tmp.spec

# Iconos generados durante el build (ahora en desktop/build/; los scripts
# anteriores los dejaban en desktop/)
desktop/*.ico
desktop/*.icns

# --- Logs y temporales -----------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp

# --- Windows ---------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- macOS ----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# --- IDEs / editores -------------------------------------------------------
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# NO ignorar recursos necesarios (se mantienen explícitamente versionados):
#   extension/icons/*.png   -> iconos de la extensión
#   desktop/**/*.py         -> código fuente
#   hybrid/**/*.py          -> código fuente (y hybrid/hybrid/web/agent.js)
#   *.spec                  -> receta de empaquetado
#   */releases/             -> ejecutables listos para usar
# ---------------------------------------------------------------------------
